# Realtime Trains API credentials. Create a personal account at api.rtt.io.
# No token is committed; the backend cannot fetch live data without one.
RTT_REFRESH_TOKEN=your_refresh_token_here
RTT_BASE_URL=https://data.rtt.io

# Comma-separated browser origins allowed to call the API.
# Set this in Render to the deployed frontend origin, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only used when running `python server.py` directly. Leave unset/false in
# production (render.yaml and the Dockerfile run via waitress instead, which
# ignores this). Never set true on a deployed instance.
FLASK_DEBUG=false